{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "mamas_mart-main/mamas_mart/wsgi.py": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/mamas_mart_static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/mamas_mart-main/mamas_mart/wsgi.py"
    }
  ]
}
