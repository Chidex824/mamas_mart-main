{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "mamas_mart-main/mamas_mart/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/mamas_mart_static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "mamas_mart-main/mamas_mart/wsgi.py"
    }
  ]
}
